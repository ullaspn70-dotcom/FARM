# Database
DATABASE_URL=postgresql://bioshield:bioshield@localhost:5432/bioshield

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# App
APP_NAME=AgriSentinel API
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File storage (local uploads directory)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
STORAGE_BASE_URL=http://localhost:8000/uploads

# Default district for new farms
DEFAULT_DISTRICT_ID=district-ranchi

# Optional — enables real AI image vision analysis on evidence uploads
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
